// MQTT Брокер
Bridge mqtt:broker:mosquitto "Mosquitto MQTT Broker" [
    host="127.0.0.1",
    port=1883,
    secure=false,
    clientID="OpenHAB3_Greenhouse"
] {
    // Вузол ESP32 Теплиця
    Thing topic esp32_greenhouse "ESP32 Greenhouse Node" {
    Channels:
        // Датчики
        Type number : air_temp "Air Temperature" [ stateTopic="greenhouse/sensors/air_temperature" ]
        Type number : air_hum  "Air Humidity"    [ stateTopic="greenhouse/sensors/air_humidity" ]
        Type number : soil_temp "Soil Temperature" [ stateTopic="greenhouse/sensors/soil_temperature" ]
        Type number : soil_moist "Soil Moisture"  [ stateTopic="greenhouse/sensors/soil_moisture" ]
        Type number : lux        "Illuminance"    [ stateTopic="greenhouse/sensors/illuminance" ]
        Type number : air_qual   "Air Quality"    [ stateTopic="greenhouse/sensors/air_quality" ]

        // Актуатори
        Type switch : pump   "Water Pump"    [ stateTopic="greenhouse/actuators/pump/state", commandTopic="greenhouse/actuators/pump/set", on="ON", off="OFF" ]
        Type dimmer : fan    "Ventilation Fan" [ stateTopic="greenhouse/actuators/fan/state", commandTopic="greenhouse/actuators/fan/set" ]
        Type dimmer : led    "Fyto LED Light" [ stateTopic="greenhouse/actuators/led/state", commandTopic="greenhouse/actuators/led/set" ]
        Type switch : heater "Heater Relay"   [ stateTopic="greenhouse/actuators/heater/state", commandTopic="greenhouse/actuators/heater/set", on="ON", off="OFF" ]
        Type number : window "Window Servo Angle" [ stateTopic="greenhouse/actuators/window/state", commandTopic="greenhouse/actuators/window/set" ]
    }
}

// Астрономічний Binding для визначення сходу та заходу сонця
astro:sun:home "Sun Data" [ latitude=50.4501, longitude=30.5234, interval=300 ]

// Network Binding для контролю доступності ESP32
network:pingdevice:esp32_ping "ESP32 Ping Monitor" [ hostname="192.168.1.150", retry=1, timeout=5000 ]